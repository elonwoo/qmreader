{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "QMReader",
  "version": "1.0.16",
  "identifier": "dev.qmreader.mac",
  "build": {
    "frontendDist": "../public"
  },
  "app": {
    "windows": [
      {
        "title": "QMReader",
        "width": 1440,
        "height": 920,
        "minWidth": 960,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "backgroundColor": "#f7f7f6"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "externalBin": ["binaries/node"],
    "resources": ["runtime"],
    "category": "public.app-category.news",
    "shortDescription": "QMReader RSS reader",
    "longDescription": "QMReader desktop application: RSS reading, translation, rewrites and AI chat, powered by the original QMReader web app running on a local Unix socket.",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  }
}
